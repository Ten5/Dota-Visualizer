# ==============================================================================
# Dockerfile.backend - FastAPI Gateway & Celery Worker Container
# ==============================================================================
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Install system dependencies required for OpenCV, FFmpeg, and TrueType fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    fontconfig \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary runtime storage directories
RUN mkdir -p output/ephemeral cache assets

# Copy source code and assets
COPY src/ ./src/
COPY assets/ ./assets/

# Expose FastAPI backend port
EXPOSE 8000

# Default command: Launch FastAPI Uvicorn Server
CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
