# ==============================================================================
# Dota 2 History Visualizer - Production Environment Variables
# ==============================================================================

# System Environment (development | production)
ENVIRONMENT=production

# Security & Session JWT Secrets
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Steam OpenID 2.0 & Web API Key
# Register your API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_web_api_key_here

# Database Configuration
DATABASE_URL=sqlite:////app/data/dota.db

# Redis Message Broker (for Celery Render Pipeline & Caching)
REDIS_URL=redis://redis:6379/0

# Rate Limiting Settings
RATE_LIMIT_PER_MINUTE=60

# Ephemeral Media TTL Cleanup (in seconds)
EPHEMERAL_MEDIA_TTL=3600
